# ---- Copy to .env and fill in. NEVER commit .env ----

# ─── Database ────────────────────────────────────────────────────────────────
# Get these from Supabase: Project Settings → API
# SUPABASE_SERVICE_KEY is a server-side secret: backend only!
REPOSITORY=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─── Team login ───────────────────────────────────────────────────────────────
# Fallback env-var credentials used when no users table row is found (dev/tests).
# In production, use the SEED_USER / SEED_PASSWORD path instead.
TEAM_USER=agent
TEAM_PASSWORD=change-me-to-a-strong-password

# JWT signing secret — MUST be a long random string (32+ chars) in production.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars

# ─── Seed user (created once at startup, idempotent) ─────────────────────────
# Set both to have the app auto-create the first admin in the users table.
# Password is bcrypt-hashed before storing; never stored in plain-text.
SEED_USER=admin
SEED_PASSWORD=change-me-to-a-strong-password

# ─── Classifier ───────────────────────────────────────────────────────────────
# auto | onnx | hf | joblib | none   (model files go in backend/models/)
CLASSIFIER_BACKEND=auto
UNCLEAR_BELOW=0.35

# ─── FAQ drafts ───────────────────────────────────────────────────────────────
# mock | ollama | anthropic
LLM_PROVIDER=mock
LLM_MODEL=
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=
FAQ_MIN_SCORE=0.20

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
